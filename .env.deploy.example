# Deployment target for ./deploy.sh (copy to .env.deploy; it is git-ignored).
DEPLOY_HOST=ubuntu@your-vm-ip-or-host      # SSH target
DEPLOY_DIR=livekit-console                  # folder on the VM (relative to the SSH user's home)
CONSOLE_PORT=8090                           # console listens on 127.0.0.1:<port> on the VM
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880    # LiveKit server as seen from the VM

# ./deploy.sh webhook
LIVEKIT_CONFIG=/path/to/livekit.yaml        # LiveKit server config file on the VM
LIVEKIT_CONTAINER=livekit-livekit-1         # LiveKit server container name

# ./deploy.sh https
CONSOLE_HOST=console.example.com            # public hostname (must resolve to the VM)
ALLOWED_IPS="203.0.113.7 10.8.0.0/24"       # space-separated IPs/CIDRs allowed to open the console (e.g. your VPN exit)
