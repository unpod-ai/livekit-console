# Self-hosted LiveKit server (ws/wss URL; the server derives the http(s) URL for the admin APIs)
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Console login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

PORT=8080

# Public SIP address carriers send calls to (shown on the telephony pages; optional)
#SIP_URI=sip:sip.example.com:5060

# Agent worker status endpoints to poll (comma-separated base URLs; workers serve GET /worker on port 8081; optional)
# GitHub clone/view traffic, recorded daily (token needs push access to the repo; optional)
#GITHUB_REPO=unpod-ai/livekit-console
#GITHUB_TOKEN=
#AGENT_WORKER_URLS=http://127.0.0.1:8081

# Optional post-session agent reports. Disabled until a separate service token is configured.
# Agent Insights content is administrator-only. See docs/agent-telemetry.md before enabling collection.
#AGENT_TELEMETRY_TOKEN=
#AGENT_TELEMETRY_RETENTION_DAYS=30
# Optional explicit structured logs; enable on the console and agent.
#AGENT_LOGS_ENABLED=false
# Opt-in native SDK event/span collection; report uploads remain independent.
#AGENT_TELEMETRY_EVENTS_ENABLED=false
# Privacy applies before storage and to retained content on startup/read/export.
#AGENT_TELEMETRY_REDACTION=standard
#AGENT_TELEMETRY_REDACT_TERMS=
# Worker-only: comma-separated logger namespaces eligible for live log collection.
#AGENT_TELEMETRY_LOGGERS=livekit.agents
