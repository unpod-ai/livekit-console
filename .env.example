# Self-hosted LiveKit server (ws/wss URL; the server derives the http(s) URL for the admin APIs)
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Console login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

PORT=8080

# Public SIP address carriers send calls to (shown on the telephony pages; optional)
#SIP_URI=sip:sip.example.com:5060

# Agent worker status endpoints to poll (comma-separated base URLs; workers serve GET /worker on port 8081; optional)
# GitHub clone/view traffic, recorded daily (token needs push access to the repo; optional)
#GITHUB_REPO=unpod-ai/livekit-console
#GITHUB_TOKEN=
#AGENT_WORKER_URLS=http://127.0.0.1:8081
# Durable inventory retains hourly sampled checks after raw samples expire.
#WORKER_ROLLUP_RETENTION_DAYS=365
# Optional safe metadata, keyed by the exact configured endpoint; never include secrets.
#AGENT_WORKER_METADATA={"http://127.0.0.1:8081":{"instanceKey":"deployment-1","version":"v1","environment":"production"}}

# Optional post-session agent reports. Disabled until a separate service token is configured.
# Agent Insights content is administrator-only. See docs/agent-telemetry.md before enabling collection.
#AGENT_TELEMETRY_TOKEN=
#AGENT_TELEMETRY_RETENTION_DAYS=30
# Optional explicit structured logs; enable on the console and agent.
#AGENT_LOGS_ENABLED=false
# Opt-in native SDK event/span collection; report uploads remain independent.
#AGENT_TELEMETRY_EVENTS_ENABLED=false
# Privacy applies before storage and to retained content on startup/read/export.
#AGENT_TELEMETRY_REDACTION=standard
#AGENT_TELEMETRY_REDACT_TERMS=
# Worker-only: comma-separated logger namespaces eligible for live log collection.
#AGENT_TELEMETRY_LOGGERS=livekit.agents
# Administrator-only recording playback. Only referenced files in this configured S3 bucket/prefix are read.
# Use read-only s3:GetObject credentials or an instance role; never put credentials in browser configuration.
#RECORDING_S3_BUCKET=
#RECORDING_S3_PREFIX=recordings/
#RECORDING_S3_REGION=us-east-1
#RECORDING_S3_ENDPOINT=
#RECORDING_S3_FORCE_PATH_STYLE=false
#RECORDING_ACCESS_DAYS=30
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN are read by the server SDK when needed.

# Opt-in measured connection quality, host service snapshots and SIP diagnostics.
# Uploads use AGENT_TELEMETRY_TOKEN; only administrators may read diagnostics.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_RETENTION_DAYS=30
# Native integration requires examples/connection_quality.py and explicit attachment.
AGENT_QUALITY_ENABLED=false
